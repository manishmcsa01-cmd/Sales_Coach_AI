# ==============================================================================
# GCash Sales Coach AI - Environment Configuration Template
# ==============================================================================

# Application Environment (staging | production)
APP_ENV=production

# Security Secret Key for Session / JWT signing
SECRET_KEY=change-this-secret-key-in-production

# PostgreSQL Database Connection URL (AsyncPG driver)
DATABASE_URL=postgresql+asyncpg://user:pass@rds-endpoint:5432/salescoach_db

# Redis Connection URL
REDIS_URL=redis://elasticache-endpoint:6379/0

# AWS General Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Amazon Bedrock (Foundation Models & Safety Guardrails)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_GUARDRAIL_ID=arn:aws:bedrock:ap-southeast-1:123456789012:guardrail/abcd12345678
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Amazon S3 & DynamoDB Configuration
S3_BUCKET_NAME=salescoach-production-data
DYNAMODB_TABLE_PREFIX=salescoach-prod

# Amazon Cognito Authentication
COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Amazon SageMaker (Merchant Scorer Endpoint)
SAGEMAKER_ENDPOINT_NAME=salescoach-merchant-scorer-prod

# Amazon SNS (Notification & Alerting Topic)
SNS_ALERT_TOPIC_ARN=arn:aws:sns:ap-southeast-1:123456789012:salescoach-alerts

# Amazon OpenSearch Service Endpoint
OPENSEARCH_ENDPOINT=https://search-salescoach-domain-xxxxxxxxxxxxxx.ap-southeast-1.es.amazonaws.com

# AWS KMS (PII & Data Encryption Key)
KMS_KEY_ID=alias/salescoach-pii-key

# CloudWatch Log Group
CLOUDWATCH_LOG_GROUP=salescoach-ai
